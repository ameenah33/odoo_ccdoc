<?xml version="1.0" encoding="utf-8"?>
<odoo>

  
    <record id="view_sale_order_import_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.import.wizard.form</field>
        <field name="model">sale.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer des lignes de devis">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span invisible="state != 'upload'">📁 Étape 1 : Upload du fichier</span>
                            <span invisible="state != 'mapping'">🔗 Étape 2 : Mapping des colonnes</span>
                            <span invisible="state != 'preview'">👁️ Étape 3 : Aperçu</span>
                        </h1>
                    </div>
                    
                    <field name="state" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    
                    <!-- Étape 1 : Upload -->
                    <group invisible="state != 'upload'">
                        <group>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                <p><strong>📋 Formats supportés :</strong> Excel (.xlsx, .xls) ou CSV</p>
                                <p>Le fichier doit contenir au minimum une colonne Description ou Référence produit.</p>
                            </div>
                        </group>
                    </group>
                    
                    <!-- Étape 2 : Mapping -->
                    <group invisible="state != 'mapping'">
                        <group string="📊 Colonnes détectées">
                            <field name="detected_columns" readonly="1" widget="text" nolabel="1"/>
                        </group>
                        <group string="👁️ Aperçu des données">
                            <field name="preview_data" readonly="1" widget="text" nolabel="1"/>
                        </group>
                        
                        <separator string="🔗 Mapping des colonnes"/>
                        <p class="text-muted">
                            Indiquez le numéro de colonne (0 = première colonne, 1 = deuxième, etc.) :
                        </p>
                        
                        <group>
                            <group>
                                <field name="col_reference" placeholder="Ex: 0"/>
                                <field name="col_description" placeholder="Ex: 1"/>
                                <field name="col_quantity" placeholder="Ex: 2"/>
                            </group>
                            <group>
                                <field name="col_price" placeholder="Ex: 3"/>
                                <field name="col_discount" placeholder="Ex: 4"/>
                            </group>
                        </group>
                        
                        <separator string="⚙️ Options"/>
                        <group>
                            <group>
                                <field name="skip_header"/>
                                <field name="create_product_if_not_found"/>
                            </group>
                            <group>
                                <field name="save_template"/>
                                <field name="mapping_template_id" readonly="1" invisible="not mapping_template_id"/>
                            </group>
                        </group>
                    </group>
                    
                </sheet>
                <footer>
                    <button name="action_analyze_file" string="Analyser le fichier" type="object" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_back" string="◀ Retour" type="object" class="btn-secondary" invisible="state == 'upload'"/>
                    <button name="action_import" string="✅ Importer les lignes" type="object" class="btn-primary" invisible="state != 'mapping'"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_sale_order_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer des lignes</field>
        <field name="res_model">sale.order.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
    </record>

</odoo>
