<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Les xpaths doivent être dans le champ arch du record, pas directement sous <odoo> -->
    <record id="view_crm_lead_form_ccdoc" model="ir.ui.view">
        <field name="name">crm.lead.form.ccdoc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Les boutons Gagné/Perdu seront masqués via CSS dans les assets -->
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button name="action_open_purchase" type="object" string="Achats" class="btn-secondary"/>
                <button name="action_open_sale" type="object" string="Ventes" class="btn-secondary"/>
                <button name="action_justify_win" type="object" string="Justificatif de gain" class="oe_highlight"/>
            </xpath>
            <xpath expr="//page[@name='extra']" position="after">
                <page string="Informations CCDOC" name="ccdoc_info" invisible="context.get('default_type') == 'lead'">
                    <group>
                        <group string="Références et Classification">
                            <field name="x_bu_ids" widget="many2many_checkboxes"/>
                            <field name="x_ref_offre" string="Référence Offre"/>
                            
                        </group>
                        <group string="Dates de Validation">
                            <field name="x_date_depot"/>
                            <field name="x_date_validation_dc"/>
                            <field name="x_deadline_validation_dc"/>
                            <field name="x_date_validation_dt"/>
                            <field name="x_deadline_validation_dt"/>
                            <field name="x_date_commande"/>
                        </group>
                    </group>
                    <group string="Suivi">
                        <field name="x_blocage" placeholder="Blocages rencontrés..."/>
                        <field name="x_etape_suivante" placeholder="Prochaine action..."/>
                    </group>
                    <group string="Statut et Responsabilité">
                        <field name="x_statut"/>
                        <field name="x_responsable" widget="many2many_tags"/>
                        <field name="x_priorite"/>
                    </group>
                    <group string="Planification">
                        <field name="x_deadline"/>
                        <field name="x_date_demande"/>
                        <field name="x_avancement"/>
                    </group>
                    <group string="Prévisions">
                        <field name="x_forecast"/>
                    </group>
                    <group string="Projet">
                        <field name="project_id"/>
                    </group>
                    <group string="Notification d'envoi au client">
                        <field name="x_contacts_a_notifier" widget="many2many_tags"/>
                        <field name="x_envoi_notifie"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Le bouton "Générer des Pistes" est masqué via CSS dans hide_quick_buttons.css -->

    <!-- Filtres de recherche par commercial -->
    <record id="view_crm_lead_search_ccdoc" model="ir.ui.view">
        <field name="name">crm.lead.search.ccdoc</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <!-- Ajout du champ Responsable (custom) dans la barre de recherche -->
            <xpath expr="//search/field[@name='user_id']" position="after">
                <field name="x_responsable" string="Responsable"/>
            </xpath>
            <!-- Filtre "Mes opportunités" : user_id OU x_responsable -->
            <xpath expr="//search/filter[@name='assigned_to_me']" position="after">
                <filter string="Mes opportunités"
                        name="my_opportunities_ccdoc"
                        domain="['|', ('user_id', '=', uid), ('x_responsable', 'in', [uid])]"/>
            </xpath>
        </field>
    </record>

</odoo>
