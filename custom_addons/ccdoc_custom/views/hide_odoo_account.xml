<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Masquer le lien "Mon compte Odoo.com" dans le menu utilisateur -->
    <template id="hide_odoo_account_link" inherit_id="base.user_menu_items" name="Hide Odoo Account Link">
        <xpath expr="//a[@data-menu='odoo_account']" position="replace">
            <a style="display:none;" data-menu="odoo_account"/>
        </xpath>
    </template>

</odoo>
