<odoo>
    <!-- Vue formulaire héritée -->
    <record id="view_project_form_ccdoc" model="ir.ui.view">
        <field name="name">project.project.form.ccdoc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Informations CCDOC">
                    <group>
                        <group string="Références et Classification">
                            <field name="x_ref_projet"/>
                            <field name="x_bu_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Responsabilité">
                            <field name="x_responsable" widget="many2many_tags"/>
                            <field name="x_priorite"/>
                            <field name="x_equipe" widget="many2many_tags"/>
                        </group>
                        <group string="Dates et Planification initiale">
                            <field name="x_date_demande"/>
                            <field name="x_date_depot"/>
                            <field name="x_date_validation_dc"/>
                            <field name="x_date_validation_dt"/>
                            <field name="x_date_debut"/>
                            <field name="x_date_fin"/>
                            <field name="x_deadline"/>
                            <field name="x_charge_prevue"/>
                        </group>
                        <group string="Suivi">
                            <field name="x_avancement"/>
                            <field name="x_blocage"/>
                            <field name="x_etape_suivante"/>
                            <field name="x_motif_blocage"/>
                        </group>
                        <group string="Budget">
                            <field name="x_budget_prevu"/>
                            <field name="x_budget_realise"/>
                        </group>
                    </group>
                </page>
                <page string="Tâches" name="tasks_page">
                    <div class="text-center py-4">
                        <h3>Gestion des tâches du projet</h3>
                        <p class="text-muted">Cliquez sur le bouton ci-dessous pour accéder au tableau kanban des tâches.</p>
                        <button name="%(project.act_project_project_2_project_task_all)d"
                                type="action"
                                string="Ouvrir les tâches"
                                class="btn btn-primary btn-lg"
                                context="{'default_project_id': active_id, 'search_default_project_id': active_id}"
                        />
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vue liste des projets -->
    <record id="view_project_list_ccdoc" model="ir.ui.view">
        <field name="name">project.project.list.ccdoc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_ref_projet"/>
                <field name="x_priorite"/>
                <field name="x_responsable" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <!-- Hériter de l'action principale des projets pour grouper par étape -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>

    <!-- Filtres de recherche -->
    <record id="view_project_search_ccdoc" model="ir.ui.view">
        <field name="name">project.project.search.ccdoc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <!-- Champs de recherche par membre de l'équipe commerciale -->
            <xpath expr="//search/field[last()]" position="after">
                <field name="user_id" string="Chef de projet"/>
                <field name="x_responsable" string="Responsable"/>
            </xpath>
            <!-- Filtres rapides -->
            <xpath expr="//search/filter[last()]" position="after">
                <separator/>
                <filter string="Mes projets"
                        name="my_projects"
                        domain="['|', ('user_id', '=', uid), ('x_responsable', 'in', [uid])]"/>
            </xpath>
            <!-- Regroupements -->
            <xpath expr="//search/group" position="inside">
                <filter string="Étape" name="group_by_stage_id" context="{'group_by': 'stage_id'}"/>
                <filter string="Chef de projet" name="group_by_user_id" context="{'group_by': 'user_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Hériter de la vue Kanban par défaut des projets -->
    <record id="view_project_kanban_inherit_ccdoc" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.ccdoc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="action"></attribute>
                <attribute name="type"></attribute>
            </xpath>
            <xpath expr="//kanban/field[@name='partner_id']" position="after">
                <field name="x_ref_projet"/>
                <field name="x_priorite"/>
                <field name="x_avancement"/>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_record_bottom')]" position="before">
                <div t-if="record.x_ref_projet.value" class="text-muted small mb-1">
                    <i class="fa fa-tag"/> <field name="x_ref_projet"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
