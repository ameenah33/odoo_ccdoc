<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PLANNER.TASK.STAGE — Vues des étapes de tâches
    ============================================================ -->
    <record id="view_planner_task_stage_list" model="ir.ui.view">
        <field name="name">planner.task.stage.list</field>
        <field name="model">planner.task.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
            </tree>
        </field>
    </record>

    <record id="action_planner_task_stage" model="ir.actions.act_window">
        <field name="name">Étapes des tâches Planner</field>
        <field name="res_model">planner.task.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============================================================
         PLANNER.TASK — Vues des tâches
    ============================================================ -->

    <!-- Kanban tâches -->
    <record id="view_planner_task_kanban" model="ir.ui.view">
        <field name="name">planner.task.kanban</field>
        <field name="model">planner.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="priority"/>
                <field name="kanban_state"/>
                <field name="deadline"/>
                <field name="user_ids"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.deadline.value" class="text-muted small">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="deadline"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="kanban_state" widget="kanban_state_selection"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_ids" widget="many2many_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Liste tâches -->
    <record id="view_planner_task_list" model="ir.ui.view">
        <field name="name">planner.task.list</field>
        <field name="model">planner.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="stage_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="deadline"/>
                <field name="priority"/>
                <field name="kanban_state"/>
            </tree>
        </field>
    </record>

    <!-- Formulaire tâche -->
    <record id="view_planner_task_form" model="ir.ui.view">
        <field name="name">planner.task.form</field>
        <field name="model">planner.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la tâche..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Organisation">
                            <field name="plan_id"/>
                            <field name="stage_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state"/>
                        </group>
                        <group string="Responsabilité">
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="deadline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description détaillée..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action tâches (globale) -->
    <record id="action_planner_task_all" model="ir.actions.act_window">
        <field name="name">Toutes les tâches</field>
        <field name="res_model">planner.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune tâche pour l'instant</p>
            <p>Les tâches sont créées depuis les Plans.</p>
        </field>
    </record>

    <!-- ============================================================
         PLANNER.PLAN — Vues des plans
    ============================================================ -->

    <!-- Kanban plans -->
    <record id="view_planner_plan_kanban" model="ir.ui.view">
        <field name="name">planner.plan.kanban</field>
        <field name="model">planner.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="task_count"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.partner_id.value" class="text-muted small">
                                        <i class="fa fa-building-o me-1"/>
                                        <field name="partner_id"/>
                                    </div>
                                    <div t-if="record.date_end.value" class="text-muted small mt-1">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="date_end"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <button name="action_open_tasks"
                                                type="object"
                                                class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-tasks me-1"/>
                                            <t t-esc="record.task_count.value"/> Tâche(s)
                                        </button>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Liste plans -->
    <record id="view_planner_plan_list" model="ir.ui.view">
        <field name="name">planner.plan.list</field>
        <field name="model">planner.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="task_count"/>
                <field name="project_id"/>
            </tree>
        </field>
    </record>

    <!-- Formulaire plan -->
    <record id="view_planner_plan_form" model="ir.ui.view">
        <field name="name">planner.plan.form</field>
        <field name="model">planner.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tâches"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du plan..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations générales">
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Liens">
                            <field name="opportunity_id"
                                   domain="[('type', '=', 'opportunity')]"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description du plan..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Recherche plans -->
    <record id="view_planner_plan_search" model="ir.ui.view">
        <field name="name">planner.plan.search</field>
        <field name="model">planner.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Plan"/>
                <field name="partner_id" string="Client"/>
                <field name="user_id" string="Responsable"/>
                <field name="project_id" string="Projet"/>
                <filter string="Mes plans" name="my_plans"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="En cours" name="in_progress"
                        domain="[('stage_id.is_closing', '=', False)]"/>
                <filter string="Terminés" name="closed"
                        domain="[('stage_id.is_closing', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Étape" name="group_stage"
                            context="{'group_by': 'stage_id'}"/>
                    <filter string="Responsable" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Client" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action plans -->
    <record id="action_planner_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">planner.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_plans': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier plan</p>
            <p>Les plans permettent d'organiser et de suivre vos projets.</p>
        </field>
    </record>

    <!-- ============================================================
         MENUS
    ============================================================ -->

    <!-- Sous-menu Planner sous CCDOC -->
    <menuitem id="menu_planner_root"
              name="Planner"
              parent="menu_ccdoc_root"
              sequence="5"/>

    <menuitem id="menu_planner_plans"
              name="Mes Plans"
              parent="menu_planner_root"
              action="action_planner_plan"
              sequence="1"/>

    <menuitem id="menu_planner_tasks"
              name="Toutes les Tâches"
              parent="menu_planner_root"
              action="action_planner_task_all"
              sequence="2"/>

    <!-- Configuration -->
    <menuitem id="menu_planner_config"
              name="Configuration"
              parent="menu_planner_root"
              sequence="99"/>

    <menuitem id="menu_planner_task_stages"
              name="Étapes des tâches"
              parent="menu_planner_config"
              action="action_planner_task_stage"
              sequence="1"/>

</odoo>
