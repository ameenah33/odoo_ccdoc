<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu principal Ticketing (visible pour tous les rôles Ticketing) -->
    <menuitem id="menu_ccdoc_ticketing_root"
              name="Ticketing"
              web_icon="project,static/description/icon.png"
              groups="ccdoc_ticketing.group_ccdoc_ticketing_requester"
              sequence="25"/>

    <!-- Sous-menus -->
    <menuitem id="menu_ccdoc_ticketing_tickets"
              name="Tickets"
              parent="menu_ccdoc_ticketing_root"
              groups="ccdoc_ticketing.group_ccdoc_ticketing_requester"
              sequence="10"/>

    <menuitem id="menu_ccdoc_ticket_all"
              name="Tous les tickets"
              parent="menu_ccdoc_ticketing_tickets"
              action="action_ccdoc_ticket"
              groups="ccdoc_ticketing.group_ccdoc_ticketing_agent"
              sequence="10"/>

    <menuitem id="menu_ccdoc_ticket_my"
              name="Mes tickets"
              parent="menu_ccdoc_ticketing_tickets"
              action="action_ccdoc_ticket_my"
              groups="ccdoc_ticketing.group_ccdoc_ticketing_requester"
              sequence="20"/>

    <!-- Configuration (visible uniquement pour les Administrateurs) -->
    <menuitem id="menu_ccdoc_ticketing_config"
              name="Configuration"
              parent="menu_ccdoc_ticketing_root"
              sequence="100"
              groups="ccdoc_ticketing.group_ccdoc_ticketing_admin"/>

    <menuitem id="menu_ccdoc_ticket_stage"
              name="Étapes"
              parent="menu_ccdoc_ticketing_config"
              action="action_ccdoc_ticket_stage"
              sequence="10"/>

    <menuitem id="menu_ccdoc_ticket_category"
              name="Catégories"
              parent="menu_ccdoc_ticketing_config"
              action="action_ccdoc_ticket_category"
              sequence="20"/>

    <menuitem id="menu_ccdoc_ticket_tag"
              name="Tags"
              parent="menu_ccdoc_ticketing_config"
              action="action_ccdoc_ticket_tag"
              sequence="30"/>

</odoo>
